# One line ending everywhere (matches .editorconfig), so worktrees and merges never fight over CRLF.
* text=auto eol=lf

# Binary assets: never touched by line-ending conversion or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.gltf binary
*.bin binary
*.hdr binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.zip binary
*.pdf binary
