{
  "name": "catch-the-thief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/postbuild.mjs",
    "build:poki": "tsc --noEmit && vite build --mode poki && node tools/postbuild.mjs --mode poki",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && node tools/postbuild.mjs --mode crazygames",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "patterns": "vitest run --config tools/patterns/vitest.config.mjs",
    "stress": "vitest run --config tools/stress.config.mjs",
    "smoke": "node tools/smoke.mjs",
    "devices": "node tools/devices.mjs",
    "loadtime": "node tools/loadtime.mjs",
    "budget": "node tools/budget.mjs",
    "profile": "node tools/profile.mjs",
    "assets:fetch": "node tools/assets/fetch-polypizza.mjs && node tools/assets/snapshot.mjs",
    "assets:world": "node tools/assets/build-world.mjs && node tools/assets/check-kit.mjs",
    "assets:obstacles": "node tools/assets/build-obstacles.mjs",
    "assets:buildings": "node tools/assets/build-buildings.mjs",
    "assets:scenery": "node tools/assets/build-scenery.mjs",
    "assets:chars": "node tools/assets/build-characters.mjs",
    "assets:cop": "node tools/assets/build-cop.mjs",
    "assets:credits": "node tools/assets/credits.mjs && node tools/assets/check-credits.mjs",
    "assets:all": "npm run assets:fetch && npm run assets:world && npm run assets:chars && npm run assets:credits",
    "inspect": "node tools/assets/inspect-models.mjs",
    "icons": "node tools/make-icons.mjs",
    "tripo:rig": "node tools/tripo/rig.mjs",
    "tripo:retarget": "node tools/tripo/retarget.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "0.187.0",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
